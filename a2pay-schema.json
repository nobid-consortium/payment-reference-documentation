{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A2Pay",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "maxLength": 250,
      "description": "Identifier of the issuer",
      "format": "uri",
      "examples": [
        "https://bank.example.com/"
      ]
    },
    "psp": {
      "type": "string",
      "maxLength": 250,
      "description": "Identifier of the the PSP",
      "format": "uri",
      "examples": [
        "https://bank.example.com/"
      ]
    },
    "iat": {
      "type": "integer",
      "examples": [
        1718198433
      ]
    },
    "exp": {
      "type": "integer",
      "examples": [
        1718198433
      ]
    },
    "nbf": {
      "type": "integer",
      "examples": [
        1718198433
      ]
    },
    "sub": {
      "type": "string",
      "maxLength": 100,
      "description": "Name or ID of the account the A2Pay is connected to",
      "minLength": 1,
      "examples": [
        "IBAN ****6199",
        "DE75512108001245126199",
        "+491232233445566",
        "me@example.com"
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 36,
      "description": "Unique identifier of the issued attestation.",
      "minLength": 1,
      "examples": [
        "8D8AC610-566D-4EF0-9C22-186B2A5ED793"
      ]
    },
    "scheme": {
      "type": "string",
      "maxLength": 35,
      "description": "Scheme the account is connected to (e.g. sct-eu, sct-inst-eu, domestic such as bancomat-pay).",
      "minLength": 1,
      "examples": [
        "sct-eu",
        "sct-inst-eu",
        "bancomat-pay"
      ]
    }
  },
  "additionalProperties": true,
  "required": ["iss", "iat", "nbf", "exp", "sub", "id"]
}